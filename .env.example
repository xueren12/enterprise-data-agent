DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DATABASE_URL=postgresql+psycopg://agent_reader:agent_reader_password@localhost:15432/agent_db
DEFAULT_DATA_SOURCE=auto
SQL_MAX_LIMIT=200
SQL_MAX_RETRIES=2
SQL_STATEMENT_TIMEOUT_MS=5000
# Docker Compose 专用覆盖项；通常无需设置。
COMPOSE_DATABASE_URL=postgresql+psycopg://agent_reader:agent_reader_password@postgres:5432/agent_db
COMPOSE_DEFAULT_DATA_SOURCE=postgresql
